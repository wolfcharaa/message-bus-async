{
    "name": "romanfedorskij/message-bus-async",
    "description": "Async-first PHP message bus with typed local dispatch and durable producer contracts",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4.12",
        "ext-json": "*",
        "amphp/amp": "^3.1",
        "amphp/postgres": "^2.2.1",
        "psr/clock": "^1.0",
        "symfony/var-exporter": "^7.4 || ^8.1"
    },
    "autoload": {
        "psr-4": {
            "Fedor\\MessageBus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fedor\\MessageBus\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "romanfedorskij",
            "email": "markaryanroma@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --level=max src tests integration-tests",
        "test": "phpunit --do-not-cache-result",
        "test:integration": "phpunit --configuration phpunit.integration.xml.dist --do-not-cache-result"
    },
    "minimum-stability": "stable",
    "suggest": {
        "psr/container": "Required to use the optional PSR-11 service resolver",
        "thesis/dic": "Required to use the optional Thesis DIC scope adapter and MessageBusModule"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.0",
        "psr/container": "^2.0",
        "thesis/dic": "^0.5.3"
    }
}
