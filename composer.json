{
    "name": "romanfedorskij/message-bus-async",
    "description": "Async-first PHP message bus with typed local dispatch and durable producer contracts",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4.12",
        "ext-json": "*",
        "amphp/amp": "^3.1",
        "symfony/var-exporter": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Fedor\\MessageBus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fedor\\MessageBus\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "romanfedorskij",
            "email": "markaryanroma@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --level=max src tests",
        "test": "phpunit --do-not-cache-result"
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.0"
    }
}
